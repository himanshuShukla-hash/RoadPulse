{
  "manifest_version": 3,
  "name": "RoadPulse — Safety-Aware Maps Companion",
  "version": "2.1.0",
  "description": "Live road-safety indices and risk recommendations overlaid directly on Google Maps.",
  "action": {
    "default_popup": "index.html",
    "default_title": "RoadPulse Safety Navigator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.in/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "*://*.google.com/*",
    "*://*.google.co.in/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
